#!/usr/bin/env bash
# R3-9a resume: the timeline readers over n3142 (unheld) / n3144 (held) CSVs.
# Scratch driver; its full text is printed into the log first.
set -u
cd /home/cah/r2d2/code/fpga/fable5_llm || exit 1
R=evidence/qwen9b/sr; W9=tb/scripts/w9; PY=/home/cah/.venv/bin/python
echo "----- driver text:"; cat "$0"; echo "----- end driver text"
sha_of () { # $1 log, $2 stem -> the CSV sha the run logged for that stem's section
  awk -v st="$2" '/^######## /{on=($2==st)} on && /^    CSV .* sha256 /{print $NF; exit}' "$1"; }
F=0
for s in 1 2 3 4; do
  L=$(echo a b c d | cut -d" " -f$s)
  T=$(ls $R/n3142${L}_*.log); H=$(ls $R/n3144${L}_*.log)
  for k in bcast bcast_overlap bcast_bp bcast_ragged bcast_late; do
    st=r3_9a_${k}_s$s; sh=$(sha_of "$T" "$st")
    echo "######## s$s $k windows (CSV from $(basename $T))"
    if [ "$k" = bcast_bp ]; then
      shh=$(sha_of "$H" "$st")
      $PY $R/r3_9a_windows.py $W9/$st.e4 $W9/$st.timeline.csv "$sh" --vs $W9/${st}_hold.timeline.csv "$shh" || F=1
    else
      $PY $R/r3_9a_windows.py $W9/$st.e4 $W9/$st.timeline.csv "$sh" || F=1
    fi
    if [ "$k" = bcast_overlap ]; then
      echo "######## s$s $k overlap reader"
      $PY $R/sr13a_overlap_tl.py $W9/$st.timeline.csv "$sh" $W9/$st.e4 || F=1
    fi
  done
done
[ $F = 0 ] && echo "R3_9A_TIMELINE_READERS: ALL RAN" || echo "R3_9A_TIMELINE_READERS: FAIL"
exit $F
