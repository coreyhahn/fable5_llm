#!/usr/bin/env bash
# R3-9a resume: ONE chip mutant over 4 seeds of its broadcast coverage stream;
# every run MUST FAIL.  Scratch driver; its text is printed into the log.
#   mutrun.sh <set> <kind> [hold]   (K = the set's obj_dir tag, r3_8_mutants.sh --meta)
set -u
cd /home/cah/r2d2/code/fpga/fable5_llm || exit 1
echo "----- driver text:"; cat "$0"; echo "----- end driver text"
R=evidence/qwen9b/sr; SET=$1; KIND=$2; HOLD=${3:-}
META=$(bash $R/r3_8_mutants.sh --meta "$SET") || exit 2
TAG=$(echo "$META" | cut -d" " -f1); export K=$TAG
echo "=== set $SET: meta '$META' -> K=$K"
echo "=== n3140's recorded sha: $(awk -v s="$SET" '/^######## set /{on=($3==s)} on && /binary sha256/{print $NF; exit}' $R/n3140_r3_9a_mut_builds.log)"
echo "=== re-hash now        : $(sha256sum tb/obj_dir_seq_chip_sr$K/tb_seq_chip_9b_sr$K | cut -d" " -f1)"
CAUGHT=0
for s in 1 2 3 4; do
  st=r3_9a_${KIND}_s$s
  args=(--plusarg +caps_expect=fab1ca07)
  [ -n "$HOLD" ] && args+=(--plusarg +xp_hold=$HOLD --logtag hold)
  echo "######## $SET on $st ${HOLD:+(+xp_hold=$HOLD)} — MUST FAIL"
  if bash $R/run_sr_chip.sh "$st" "$st" control "${args[@]}"; then
    echo "    MUTANT $SET PASSED on $st — VACUOUS"
  else
    CAUGHT=$((CAUGHT + 1)); sl=$R/sr${K}_seed_${st}_control${HOLD:+_hold}.log
    echo "    MUTANT $SET FAILED on $st, first failure lines of $sl:"
    grep -m3 -E "%Fatal|MEM\[|%Error|WATCHDOG" "$sl" | sed 's/^/      /'
  fi
done
echo "R3_9A_MUTANT $SET on $KIND: $CAUGHT of 4 seeds CAUGHT"
[ "$CAUGHT" = 4 ]
----- end driver text
