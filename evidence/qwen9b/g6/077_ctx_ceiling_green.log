$PY -u ref/seq_chat.py --selftest 2>&1 | tail -6
echo "   rc=${PIPESTATUS[0]}"
echo
echo "########## [3] the ceiling and the blob, per model selection"
for t in unset 2b 9b; do
  if [ $t = unset ]; then unset FABLE5_MODEL; else export FABLE5_MODEL=$t; fi
  $PY -c "
import sys; sys.path[:0]=[\"sw\",\"ref\"]
import chat_seq as C, hwmap as H
print(\"  FABLE5_MODEL=%-5s T_MAX %-5d (hwmap.STATE_T_MAX %d)  POS_STRIDE %-5d POSBLOB %9d B = %.1f MiB  XRF_POS_MAX %d\" % (
  C.MODEL_TAG, C.T_MAX, H.STATE_T_MAX, C.POS_STRIDE, C.POSBLOB_BYTES,
  C.POSBLOB_BYTES/2**20, C.SC.XRF_POS_MAX))"
done
echo
echo "########## [4] the refusal, live, at FABLE5_MODEL=9b — BEFORE the lock and the board"
FABLE5_MODEL=9b $PY sw/chat_seq.py --nch 4 --pos-mode xrf --prompt hi --ntok 1 2>&1 | tail -6
echo "   rc=${PIPESTATUS[0]}"

