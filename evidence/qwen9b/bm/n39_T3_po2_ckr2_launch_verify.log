=== cmd : bash -c 
echo "SV date: $(date -Is)"
echo "SV fullimpl Vivado processes:"; ps -eo pid,etime,args | grep "unwrapped/lnx64.o/[v]ivado -mode batch -nojournal -log fullimpl.log" | cut -c1-60 | sed "s/^/SV   /"
for p in $(pgrep -f "unwrapped/lnx64.o/vivado -mode batch -nojournal -log fullimpl.log"); do echo "SV   pid $p cwd $(readlink /proc/$p/cwd)"; done
for d in synth/out_build_042_bm1_ckr2_AltSpreadLogic_high synth/out_build_042_bm1_ckr2_AltSpreadLogic_medium synth/out_build_042_bm1_ckr2_ExtraNetDelay_high synth/out_build_042_bm1_ckr2_ExtraTimingOpt; do
  echo "SV ## $d  proj=$(du -sh $d/proj | cut -f1)  created=$(stat -c %w $d 2>/dev/null)"
  grep -hE "^(EXTRA_XDC|FULL_IMPL_CFG|ERROR|FATAL|CRITICAL WARNING)" $d/fullimpl.log | sed "s/^/SV   /"
  echo "SV   ERROR count: $(grep -c "^ERROR" $d/fullimpl.log)"
  tail -2 $d/fullimpl.log | cut -c1-160 | sed "s/^/SV   tail: /"
done
echo "SV load: $(uptime)"

