for d in synth/out_build_042_bm1_ckr2b_ExtraPostPlacementOpt synth/out_build_042_bm1_ckr2b_ExtraNetDelay_low synth/out_build_042_bm1_ckr2b_AltSpreadLogic_low synth/out_build_042_bm1_ckr2b_EarlyBlockPlacement; do
