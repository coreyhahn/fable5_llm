=== cmd : bash -c 
N=synth/out_build_042_bm1; S=synth/out_build_041
echo "BR report mtimes (fresh = after launch 2026-09-24T23:16:09):"; ls -la --time-style=full-iso $N/reports/*.rpt $N/proj/stage1.runs/impl_1/*.bit $N/proj/stage1.runs/impl_1/*routed*.dcp $N/proj/stage1.runs/impl_1/*.mmi 2>&1 | awk "{print \"BR   \" \$6, \$7, \$5, \$9}"
echo "BR build_run TIMING/CLOCK_GATE:"; grep -E "^(TIMING|CLOCK_GATE_OK|BUILD_OK)" $N/build_run.log | sed "s/^/BR   /"
echo "===== g5d_roll_summary: build_042_bm1 ====="
bash evidence/qwen9b/g5/g5d_roll_summary.sh $N/reports/timing_summary.rpt build_042_bm1 "base roll: launch_build.sh DEFAULT recipe, no XDC"
echo "===== g5d_roll_summary: build_041 (shipped campaign base roll, comparand) ====="
bash evidence/qwen9b/g5/g5d_roll_summary.sh $S/reports/timing_summary.rpt build_041 "shipped campaign base roll"
for R in $N $S; do
  echo "===== worst setup paths per clock (first Max Delay path of each named clock section): $R ====="
  awk "/^From Clock:|^Clock:/ {clk=\$0} /^Slack \\(VIOLATED\\)|^Slack \\(MET\\)/ && !seen[clk]++ {sl=\$0; getline; src=\$0; getline; getline; dst=\$0; print \"WP \" clk; print \"WP   \" sl; print \"WP   \" src; print \"WP   \" dst}" $R/reports/timing_summary.rpt | grep -A3 -E "WP (Clock|From Clock): +(xdma_0_axi_aclk|mmcm_clkout0(_[123])?)$" | grep -v "^--"
done
echo "===== utilization (top level) new vs 041 ====="
for k in "CLB LUTs  " "CLB Registers  " "Block RAM Tile  " "URAM  " "DSPs  "; do
  a=$(grep -m1 "^| $k" $N/reports/utilization.rpt | awk -F"|" "{gsub(/ /,\"\",\$3); print \$3}"); b=$(grep -m1 "^| $k" $S/reports/utilization.rpt | awk -F"|" "{gsub(/ /,\"\",\$3); print \$3}")
  echo "UT $k new=$a build_041=$b delta=$(echo "$a - $b" | bc)"
done
echo "===== hierarchical rows (seq_0, mvchan_*, layer_0) new vs 041: Instance | Module | Total LUTs | Logic LUTs | LUTRAMs | SRLs | FFs | RAMB36 | RAMB18 | URAM | DSP ====="
for R in $N $S; do echo "UH $R"; grep -E "^\|   (seq_0|mvchan_[0-3]|layer_0) " $R/reports/utilization_hier.rpt | tr -s " " | sed "s/^/UH   /"; done

