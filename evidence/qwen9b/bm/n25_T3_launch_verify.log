O=synth/out_build_042_bm1; S=synth/out_build_041
echo "LV date: $(date -Is)"
echo "LV processes (launcher chain + vivado):"; ps -eo pid,ppid,etime,args | grep -E "[l]aunch_build.sh build_042_bm1|[b]m_run.sh n24|unwrapped/lnx64.o/[v]ivado|[s]ynth_1|[r]unme" | grep -v vivado-mcp | cut -c1-200
echo "LV out dir:"; ls -la $O | sed "s/^/LV   /"
echo "LV build.log:"; sed "s/^/LV   /" $O/build.log
echo "LV create.log key lines:"; grep -nE "^(validate_bd_design|CREATE_PROJECT_OK|FATAL|ERROR)" $O/create.log | sed "s/^/LV   /"
echo "LV create.log mv_busy_bm mentions (non-comment):"; grep -n "mv_busy_bm" $O/create.log | grep -v -E "^[0-9]+:#" | sed "s/^/LV   /" || echo "LV   none"
echo "LV ERROR/CRITICAL WARNING counts, new vs build_041 create.log:"
for f in $O/create.log $S/create.log; do echo "LV   $f ERROR=$(grep -c "^ERROR" $f) CRIT=$(grep -c "^CRITICAL WARNING" $f) WARNING=$(grep -c "^WARNING" $f)"; done
echo "LV CRITICAL WARNING id diff (new vs 041, normalized):"
diff <(grep "^CRITICAL WARNING" $S/create.log | sort) <(grep "^CRITICAL WARNING" $O/create.log | sort) && echo "LV   IDENTICAL critical-warning set"
echo "LV WARNING diff (new vs 041, message ids + text, sorted):"
diff <(grep "^WARNING" $S/create.log | sed -E "s/[0-9.]+ ?(MB|s)//g" | sort -u) <(grep "^WARNING" $O/create.log | sed -E "s/[0-9.]+ ?(MB|s)//g" | sort -u) | sed "s/^/LV   /" | head -40
echo "LV synth_1 run dir:"; ls -la $O/proj/stage1.runs 2>/dev/null | sed "s/^/LV   /"
tail -3 $O/build_run.log 2>/dev/null | sed "s/^/LV build_run tail: /"

