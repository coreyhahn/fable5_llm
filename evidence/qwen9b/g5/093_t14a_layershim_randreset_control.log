=== cmd:  bash -c 
W=/home/cah/r2d2/code/fpga/fable5_t14a_base
R=/home/cah/r2d2/code/fpga/fable5_llm
echo "=== THE CONTROL.  079 showed 7 of 8 explicit +verilator+seed+ values fail"
echo "=== IDENTICALLY on BASE and HEAD, so the discriminator is the random-init"
echo "=== stream, not the RTL.  This isolates it completely: the SAME binaries,"
echo "=== the SAME four +seed= values, with the uninitialised state forced to"
echo "=== ZEROS (+verilator+rand+reset+0) and to ONES (+verilator+rand+reset+1)"
echo "=== instead of random.  If both trees pass at 0 and 1, nothing about the"
echo "=== DESIGN differs; only which random values land where."
for tree in BASE HEAD; do
  if [ $tree = BASE ]; then D=$W/tb; SHA=a553f18; else D=$R/tb; SHA=1dd2889; fi
  cd $D
  for rr in 0 1; do
    for s in 1 2 3 4; do
      if ./obj_dir_tb_layershim_c/tb_layershim_c +seed=$s +verilator+rand+reset+$rr \
           > /tmp/t14a_rr_${tree}_${rr}_${s}.out 2>&1; then
        echo "$tree $SHA  rand+reset+$rr  +seed=$s  PASS  $(grep -m1 TB_LAYERSHIM_C /tmp/t14a_rr_${tree}_${rr}_${s}.out | cut -c1-70)"
      else
        echo "$tree $SHA  rand+reset+$rr  +seed=$s  FAIL  $(grep -m1 -E "%Fatal" /tmp/t14a_rr_${tree}_${rr}_${s}.out | cut -c1-110)"
      fi
    done
  done
done

